rules_version = '2';
// Delish Creative OS — server-side access control.
// OWNER: edit the list below (and OWNER_EMAILS in public/config.js + functions) before deploying.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com'];
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() in ['digitalmarketing01@delishfoods.co.th']; }
    function memberRole() {
      return exists(/databases/$(database)/documents/members/$(email()))
        ? get(/databases/$(database)/documents/members/$(email())).data.role : '';
    }
    function lvl() {
      return !signedIn() ? 0 : isOwner() ? 4
        : memberRole() == 'editor' ? 3 : memberRole() == 'contributor' ? 2 : memberRole() == 'viewer' ? 1 : 0;
    }
    function rank(r) { return r == 'editor' ? 3 : r == 'contributor' ? 2 : r == 'viewer' ? 1 : 0; }

    // Who may use the app. Owner manages everyone; editors may add/remove viewers & contributors only.
    match /members/{memberEmail} {
      allow read: if lvl() >= 1 || (signedIn() && memberEmail == email());
      allow create, update: if lvl() >= 3
        && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt'])
        && rank(request.resource.data.role) > 0
        && memberEmail == memberEmail.lower()
        && (lvl() == 4 || (rank(request.resource.data.role) < 3 && (resource == null || rank(resource.data.role) < 3)));
      allow delete: if lvl() == 4 || (lvl() == 3 && rank(resource.data.role) < 3);
    }
    match /profiles/{uid} {
      allow read: if lvl() >= 1;
      allow write: if signedIn() && request.auth.uid == uid && lvl() >= 1;
    }
    // Editor-only data (approval of work, brand settings, integrations, team directory)
    match /approvals/{id} { allow read: if lvl() >= 1; allow write: if lvl() >= 3; }
    match /settings/{id}  { allow read: if lvl() >= 1; allow write: if lvl() >= 3; }
    match /team/{id}      { allow read: if lvl() >= 1; allow write: if lvl() >= 3; }
    // AI usage counters: Cloud Functions only
    match /ai_usage/{id}  { allow read, write: if false; }
    // Every other top-level collection used by the app
    match /{col}/{id} {
      allow read: if lvl() >= 1
        && !(col in ['members', 'profiles', 'approvals', 'settings', 'team', 'ai_usage']);
      allow write: if lvl() >= 2
        && !(col in ['members', 'profiles', 'approvals', 'settings', 'team', 'ai_usage']);
    }
  }
}
